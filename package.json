{
  "name": "explorer-pane-font",
  "displayName": "Explorer Font",
  "description": "Shows the explorer pane in a fixed-width font.",
  "version": "0.0.4",
  "publisher": "teolin",
  "license": "MIT",
  "icon": "icon.png",
  "private": true,
  "repository": { "type": "git", "url": "https://github.com/teo-lin/font.git" },
  "engines": { "vscode": "^1.90.0" },
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "explorerFont.pick", "title": "Pick Font", "category": "Explorer Font" },
      { "command": "explorerFont.apply", "title": "Apply", "category": "Explorer Font" },
      { "command": "explorerFont.remove", "title": "Remove", "category": "Explorer Font" }
    ],
    "configuration": {
      "title": "Explorer Font",
      "properties": {
        "explorerFont.family": {
          "type": "string",
          "scope": "application",
          "default": "Lekton, Monaco, Menlo, monospace",
          "description": "Font for the explorer pane."
        },
        "explorerFont.size": {
          "type": "number",
          "scope": "application",
          "default": 0,
          "description": "Font size in pixels for the explorer pane. 0 keeps the VSCode size."
        }
      }
    }
  }
}
